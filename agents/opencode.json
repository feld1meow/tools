{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.8:27b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 1200000
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "temperature": true,
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--slim"
      ],
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      "~/.config/opencode/external-skills/mattpocock-skills",
      "~/.config/opencode/external-skills/addyosmani-agent-skills/skills"
    ]
  }
}
